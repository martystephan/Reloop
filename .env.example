# Copy to .env (same directory as docker-compose.yml) before `docker compose up`.

# Required. Generate with: openssl rand -base64 32
SESSION_SECRET=

# The single admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional overrides
# RELOOP_IMAGE=ghcr.io/<owner>/reloop:latest
# RELOOP_PORT=8787
# DASHBOARD_ORIGINS=https://reloop.example.com
