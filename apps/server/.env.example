PORT=8787
DATABASE_PATH=./reloop.db
# Generate with: openssl rand -base64 32
SESSION_SECRET=dev-insecure-secret-change-me
# The single admin account. Change these before exposing the dashboard.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin
# Origins allowed to call the dashboard API (comma-separated)
DASHBOARD_ORIGINS=http://localhost:5173
NODE_ENV=development
